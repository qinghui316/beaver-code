{
  "name": "agent-harness-orchestrator",
  "version": "0.1.13",
  "description": "Local-first Spec-Anchored managed-run harness for AI coding.",
  "type": "module",
  "main": "dist/desktop/main.js",
  "bin": {
    "aho": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && vite build && node scripts/build-project-harness-runtime.mjs && node scripts/copy-templates.mjs && node scripts/copy-desktop-assets.mjs",
    "build:desktop": "npm run build && node scripts/generate-desktop-build-info.mjs && node scripts/build-desktop-icon.mjs",
    "dev:desktop": "npm run build:desktop && electron .",
    "package:desktop:win": "node scripts/package-desktop-win.mjs",
    "test:desktop:native": "electron scripts/desktop-native-smoke.cjs",
    "verify:desktop:package": "node scripts/verify-desktop-package.mjs",
    "generate:update-manifest": "node scripts/generate-update-manifest.mjs",
    "verify:update-release": "node scripts/verify-update-release.mjs",
    "create:update-signing-key": "node scripts/create-update-signing-key.mjs",
    "build:project-harness-runtime": "node scripts/build-project-harness-runtime.mjs",
    "dev": "tsx src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "lint": "eslint . && npm run lint:dependency-cycles",
    "test": "npm run test:fast && npm run test:integration && npm run test:workbench",
    "test:ci": "npm run test:fast -- --maxWorkers=4 --minWorkers=1 --testTimeout=120000 && npm run test:integration -- --maxWorkers=1 --minWorkers=1 --testTimeout=120000 --hookTimeout=120000 && npm run test:workbench:unit -- --maxWorkers=2 --minWorkers=1 --testTimeout=120000 --hookTimeout=120000",
    "test:fast": "vitest run --hookTimeout=30000 --exclude tests/unit/workbench-read-model.test.ts --exclude tests/unit/workbench-task-runtime.test.ts --exclude tests/unit/workbench-scheduler-runtime-surface.test.ts --exclude tests/unit/workbench-feedback-surface.test.ts --exclude tests/unit/workbench-conversation-lifecycle.test.ts --exclude tests/unit/workbench-agent-task-domain.test.ts --exclude tests/unit/workbench-demand-worker.test.ts --exclude tests/slow/** --exclude tests/integration/cli-flow.test.ts",
    "test:workbench": "npm run test:workbench:unit",
    "test:workbench:release": "npm run test:workbench:slow:release",
    "test:workbench:unit": "vitest run tests/unit/workbench-read-model.test.ts tests/unit/workbench-task-runtime.test.ts tests/unit/workbench-scheduler-runtime-surface.test.ts tests/unit/workbench-feedback-surface.test.ts tests/unit/workbench-conversation-lifecycle.test.ts tests/unit/workbench-agent-task-domain.test.ts tests/unit/workbench-demand-worker.test.ts",
    "test:workbench:slow": "vitest run tests/slow/workbench-scheduler-discard-completion-flow.test.ts tests/slow/workbench-scheduler-worker-rework-flow.test.ts tests/slow/workbench-demand-to-execution-golden-flow.test.ts tests/slow/workbench-remote-landing-flow.test.ts",
    "test:workbench:slow:release": "vitest run tests/slow/workbench-scheduler-two-worker-integration-flow.test.ts tests/slow/workbench-apply-integration-flow.test.ts",
    "test:integration": "vitest run tests/integration/cli-flow.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:contracts",
    "typecheck:contracts": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM,DOM.Iterable --strict --esModuleInterop --forceConsistentCasingInFileNames --skipLibCheck --jsx react-jsx tests/unit/conversation-experience-boundaries.test.ts",
    "lint:provider-boundaries": "node scripts/lint-provider-boundaries.mjs",
    "lint:frontend-boundaries": "node scripts/lint-frontend-boundaries.mjs",
    "lint:ui-styles": "node scripts/lint-ui-styles.mjs",
    "lint:ui-language": "node scripts/lint-ui-language.mjs",
    "lint:desktop-boundaries": "node scripts/lint-desktop-boundaries.mjs",
    "lint:dependency-cycles": "node scripts/lint-dependency-cycles.mjs",
    "office-assets:cutout": "node scripts/office-assets/office-assets.mjs cutout",
    "office-assets:pack": "node scripts/office-assets/office-assets.mjs pack",
    "office-assets:promote-handoff": "node scripts/office-assets/office-assets.mjs promote-handoff",
    "office-assets:generate-ui": "node scripts/office-assets/office-assets.mjs generate-ui",
    "office-calibration": "tsx scripts/office-calibration.ts",
    "office-calibration:validate": "tsx scripts/office-calibration.ts validate",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tweenjs/tween.js": "^25.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "13.0.3",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "pixi.js": "^8.20.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "smol-toml": "^1.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.1",
    "js-yaml": "4.3.2",
    "jsdom": "^25.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinghui316/beaver-code.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/qinghui316/beaver-code/issues"
  },
  "homepage": "https://github.com/qinghui316/beaver-code#readme"
}
